# 复制为本地环境变量文件后自行填写；本文件不得写入真实密码。
# Spring Boot 不自动读取 .env，请在终端 export，或使用 IDE 运行配置注入。

# 后端
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/tax_business?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=tax_app
DB_PASSWORD=change-me
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
EXPORT_MAX_ROWS=5000

# 测试库（mvn test 会 clean + migrate，务必指向专用测试库）
TEST_DB_URL=jdbc:mysql://localhost:3306/tax_business_test?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
TEST_DB_USERNAME=tax_app
TEST_DB_PASSWORD=change-me

# 前端（可选；默认走 Vite 代理 /api/v1）
VITE_API_BASE_URL=/api/v1
